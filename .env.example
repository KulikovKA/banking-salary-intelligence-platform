APP_ENV=poc
STORAGE_ROOT=.local/storage
LLM_MODE=fake
# Fake remains the default for tests and CI. .env is not auto-loaded.
# Enable provider mode only with a GroqCloud key supplied by the process secret store.
# LLM_MODE=provider
# LLM_MODEL=openai/gpt-oss-120b
# LLM_API_BASE=https://api.groq.com/openai/v1
# LLM_ALLOWED_HOSTS=api.groq.com
# LLM_API_KEY=<backend-only secret outside Git>
# These are local ceilings; Groq account limits and response headers remain authoritative.
LLM_CALL_TIMEOUT_SECONDS=20
LLM_TOTAL_TIMEOUT_SECONDS=45
LLM_MAX_ATTEMPTS=2
LLM_MAX_INPUT_TOKENS=4000
LLM_MAX_OUTPUT_TOKENS=1000
LLM_DAILY_TOKEN_BUDGET=10000
LLM_GLOBAL_CONCURRENCY=1
LLM_USER_CONCURRENCY=1
INGESTION_MODE=offline
BANK_FETCH_TLS_MODE=system
# BANK_FETCH_EXTRA_CA_FILE=/absolute/path/outside/repository/approved-ca.crt
